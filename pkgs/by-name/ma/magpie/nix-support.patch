# What a packaged magpie tells the program it is running under Nix:
#
#   update.go       A package build is not a release, so it does not update
#                   itself. Without this, Released() accepts the version the
#                   package passes at build time, the GUI offers the release
#                   page after a "you cannot write there" check, and
#                   `magpie update` downloads a binary meant for /nix/store.
#
#   autostart.go    The entry written for "open at login" names nixSelf, the
#                   wrapper, instead of os.Executable(), which is the binary
#                   inside it.
#
#   instance_unix.go
#                   A store copy counts as an installed magpie, so the
#                   instance lock is shared across versions rather than one
#                   per versioned path.
#
#   scheme_linux.go The package installs the desktop entry; the one written
#                   here would pin Exec to a per-version store path and, in
#                   the XDG user directory, outrank it.
--- a/internal/update/update.go
+++ b/internal/update/update.go
@@ -104,10 +104,19 @@
 	return &r, nil
 }
 
+// NixBuild marks a build whose updates belong to the package manager,
+// set at build time. Such a build has no release to compare itself against:
+// the version it reports is the package's, and replacing the binary would
+// put a file the store does not know about where the store expects one.
+var NixBuild string
+
 // Released reports whether v is a release version rather than a build from
 // source ("dev", "0bcb2cc-dirty", git describe's "v0.1.0-3-g0bcb2cc");
 // only releases update themselves.
 func Released(v string) bool {
+	if NixBuild != "" {
+		return false
+	}
 	s := parse(v)
 	return s != nil && !describe.MatchString(s.pre) && !strings.Contains(s.pre, "dirty")
 }
