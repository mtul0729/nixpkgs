 #[test]
+fn nix_update_dialog_closes_without_starting_an_install() {
+    gtk_test(
+        "ui::settings::tests::update_dialog::nix_update_dialog_closes_without_starting_an_install",
+        || {
+            let guard = install_guard();
+            guard.set(false);
+            let installer = FakeInstaller::default();
+            let (window, dialog) = open_dialog_for(&installer, &release(), UpdateMethod::Nix);
+
+            assert_eq!(dialog.action.label().as_deref(), Some("Close"));
+            dialog.action.emit_clicked();
+
+            wait_until_dismissed(&dialog);
+            assert!(installer.requests().is_empty());
+            window.destroy();
+        },
+    );
+}
