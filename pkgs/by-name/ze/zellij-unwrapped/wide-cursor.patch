+#[test]
+fn a_hollow_cursor_outlines_the_whole_wide_character() {
+    let metrics = cache().metrics();
+    let scene = scene_with_cursor(
+        1,
+        4,
+        |painter| {
+            painter.wide(0, 1, '你');
+            painter.cursor(0, 2, CursorShape::Block);
+        },
+        CursorOptions {
+            shape: None,
+            blink: None,
+            hollow: true,
+        },
+        BlinkPhase::On,
+    );
+    let x = metrics.width as i32;
+    let width = metrics.width * 2;
+    let stroke = metrics.stroke.max(1).min(width).min(metrics.height);
+    for (x, y, width, height) in [
+        (x, 0, width, stroke),
+        (x, (metrics.height - stroke) as i32, width, stroke),
+        (x, 0, stroke, metrics.height),
+        (x + (width - stroke) as i32, 0, stroke, metrics.height),
+    ] {
+        assert!(
+            scene
+                .rects
+                .iter()
+                .any(|rect| (rect.x, rect.y, rect.width, rect.height) == (x, y, width, height)),
+            "missing the {}x{} outline at ({}, {}): {:?}",
+            width,
+            height,
+            x,
+            y,
+            scene.rects
+        );
+    }
+}
