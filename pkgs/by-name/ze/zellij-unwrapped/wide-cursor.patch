+    let metrics = cache().metrics();
+    let scene = scene_with_cursor(
+        1,
+        4,
+        |painter| {
+            painter.wide(0, 1, '你');
+            painter.cursor(0, 2, CursorShape::Beam);
+        },
+        CursorOptions::default(),
+        BlinkPhase::On,
+    );
+    let stroke = metrics.stroke.max(1);
+    let beams: Vec<&Rect> = scene
+        .rects
+        .iter()
+        .filter(|rect| rect.height == metrics.height && rect.width == stroke)
+        .collect();
+    assert_eq!(beams.len(), 1, "{:?}", scene.rects);
+    assert_eq!((beams[0].x, beams[0].y), (metrics.width as i32, 0));
+}
