+#[test]
+fn a_block_cursor_covers_both_cells_of_a_wide_character() {
+    let metrics = cache().metrics();
+    for cursor_col in [1, 2] {
+        let scene = scene_with_cursor(
+            1,
+            4,
+            |painter| {
+                painter.wide(0, 1, '你');
+                painter.cursor(0, cursor_col, CursorShape::Block);
+            },
+            CursorOptions::default(),
+            BlinkPhase::On,
+        );
+        for col in [1, 2] {
+            let x = (col * metrics.width) as i32;
+            assert!(
+                scene.rects.iter().any(|rect| {
+                    (rect.x, rect.y) == (x, 0)
+                        && rect.width == metrics.width
+                        && rect.height == metrics.height
+                        && rect.color == DEFAULT_FOREGROUND
+                }),
+                "a cursor at column {} left column {} uncovered: {:?}",
+                cursor_col,
+                col,
+                scene.rects
+            );
+        }
+    }
+}
