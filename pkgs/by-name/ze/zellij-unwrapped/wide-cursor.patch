+fn cursor_unit_span(
+    state: &TerminalState,
+    preedit: Option<&PreeditOverlay>,
+    (row, col): (usize, usize),
+    size: TermSize,
+) -> (usize, usize) {
+    if row >= size.rows || col >= size.cols {
+        return (col, col + 1);
+    }
+    let at = |col: usize| match preedit.and_then(|overlay| overlay.at(row, col)) {
+        Some((cell, occupancy, _)) => (*cell, *occupancy),
+        None => (state.screen().cell(row, col), state.occupancy(row, col)),
+    };
+    let carried = |col: usize| {
+        let (cell, occupancy) = at(col);
+        occupancy == Occupancy::WideTail || cell.is_group_continuation()
+    };
+    let mut start = col;
+    while start > 0 && carried(start) {
+        start -= 1;
+    }
+    let mut end = col + 1;
+    while end < size.cols && carried(end) {
+        end += 1;
+    }
+    (start, end)
+}
